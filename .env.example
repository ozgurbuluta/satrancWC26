# Copy to .env.local for local development. Never commit real values:
# this repository is public. In production these are set in the host's
# environment settings (Vercel: Project, Settings, Environment Variables).

# Public ingestion key of THIS site's own PostHog project (EU). It is a
# write-only project key, not a secret, but it still does not belong in
# source. Leave empty to build without analytics: nothing is loaded or sent.
VITE_POSTHOG_KEY=

# Where events are sent. Default: /olay, which vercel.json forwards to
# PostHog's EU ingestion host in one hop.
VITE_POSTHOG_HOST=

# Hostname that counts as production (for example satranc.example.com).
# When set, other hosts such as previews send nothing.
VITE_ANALYTICS_HOST=

# Path the site is served under. Default: / . Use /satranc/ to serve it
# from a sub-folder of another site.
VITE_BASE_PATH=

# Address visitors should see and share, when the site is shown inside a
# page of another site (for example https://example.com/satranc/).
VITE_PUBLIC_URL=
